# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local provider keys (see .env.example)
.env
.env.local

# The first run's sign-in guide carries this server's own address (server/socialSetup.mjs).
SOCIAL_LOGIN_SETUP.ko.txt

# Local machine configuration: GPT-SoVITS paths, provider keys.
# Everything machine-specific belongs here, never in tracked source.
.env
.env.*
!.env.example

# Reference voice clips and generated audio are personal data, not code.
*.wav
*.mp3
*.ogg
*.flac

# Model weights, in case anything is ever unpacked in-tree.
*.ckpt
*.pth
*.safetensors
*.bin
*.onnx

# Test bundles written by the offline suites.
node_modules/.*-test*.mjs
data/
server/data/

# Copied from node_modules by scripts/pdf-assets.mjs, not authored here.
public/pdfjs

# The engines this app runs -- ACE-Step, GPT-SoVITS -- live here, whole: their
# own Python, their weights, your trained voices. Tens of gigabytes that are
# neither code nor the project's to publish. See engines/README.md.
engines/*
!engines/README.md

# Which tool servers the model may reach, and the keys some of them need. A
# file that names programs to spawn is a permission grant for this machine, not
# project data. See server/mcp.js.
mcp.json

# Pinned RisuAI source and reproducible browser build (npm run risu:setup).
integrations/risuai/upstream/

# local backups and one-off recovery scripts
*.bak
check_deleted_again.cjs
force_restore.cjs

# installer build output
installer/stage/
installer/app.ico
release/

NETWORK_SETUP.ko.txt
