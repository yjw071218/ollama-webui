# Copy to `.env` and fill in to make the social buttons work without any
# per-user setup — exactly how a normal website ships them.
#
# VITE_* values are inlined into the browser bundle (public identifiers only).
# Anything without the VITE_ prefix stays server-side in the dev server.
#
# ---------------------------------------------------------------------------
# Google — public client identifier, safe in a browser bundle. What protects
# it is the origin allow-list you configure.
#   https://console.cloud.google.com/apis/credentials
#   Create credentials -> OAuth client ID -> Web application
#   Authorised JavaScript origins:  http://localhost:5173
#   Leave "Authorised redirect URIs" empty; this flow does not redirect, and
#   the client secret is not used.
# Put these here rather than typing them into the app's settings box. The box
# stores them in one browser at one address, so a phone — a different origin
# with its own empty storage — gets no sign-in button. Served from .env, the
# backend hands them to every origin it answers on, so every device works.
#
# Both providers only issue tokens to origins registered in their consoles, so
# EVERY address you use has to be listed there, not just localhost:
#   http://localhost:5173  AND  http://192.168.x.x:5173
VITE_GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Kakao — the REST API key, NOT the JavaScript key.
#
# The JS SDK v2 removed Kakao.Auth.login(), so the supported flow is the
# authorization code grant. Its token endpoint rejects the JavaScript key and
# cannot be called from a browser (no CORS), so the Vite dev server performs
# the exchange at /kakao/exchange.
#
#   https://developers.kakao.com/console/app
#   1. 플랫폼 -> Web -> 사이트 도메인:  http://localhost:5173
#      (register this first, or the Redirect URI field will not accept a value)
#   2. 카카오 로그인 -> 활성화 ON
#   3. 카카오 로그인 -> Redirect URI:
#         http://localhost:5173/kakao/callback
#         http://127.0.0.1:5173/kakao/callback
#      The full path matters. A bare origin gives KOE006.
#   4. 카카오 로그인 -> 동의항목 -> 닉네임 (and 이메일 if you want it)
#   5. 앱 키 -> REST API 키  ->  paste below
VITE_KAKAO_REST_KEY=

# Kakao turns Client Secret ON by default for new REST keys. Leaving it on
# without setting this gives KOE010 "Bad client credentials".
#   Either: 카카오 로그인 -> 클라이언트 시크릿 -> 비활성화   (simplest)
#   Or:     paste the code here. No VITE_ prefix, so it is never sent to the
#           browser — the dev server adds it to the token request.
# Restart the dev server after changing this.
# Optional exact registered callback, especially behind an HTTPS reverse proxy.
# KAKAO_REDIRECT_URI=https://chat.example.com/kakao/callback
KAKAO_REDIRECT_URI=
KAKAO_CLIENT_SECRET=

# Passkeys need none of this — they work out of the box.

# ---------------------------------------------------------------------------
# Web search for the MCP tools.
#
# Scraping is not a dependable backend: DuckDuckGo starts answering a
# challenge page (HTTP 202) after a handful of requests from one address, and
# the public SearXNG instances return 403. The dev server tries the providers
# below in order and falls back to scraping, so set at least one key if you
# rely on `/web` or <TOOL_WEB_SEARCH>.
#
# None of these have a VITE_ prefix, so they never reach the browser bundle.
# Restart the dev server after editing.

# Brave Search — 2,000 queries/month free.  https://brave.com/search/api/
BRAVE_API_KEY=

# Tavily — built for LLM agents, 1,000/month free.  https://tavily.com
TAVILY_API_KEY=

# Serper — Google results, 2,500 free credits.  https://serper.dev
SERPER_API_KEY=

# Your own SearXNG, with `search.formats: [html, json]` enabled in settings.yml
# e.g. http://localhost:8080
SEARXNG_URL=

# Google, searched in the Chrome installed on this machine -- no key, no
# service in between. Chrome runs without a window in a profile of its own
# (server/data/browser-profile), never your signed-in one, and closes after
# five idle minutes. It paces itself so Google does not show a CAPTCHA: a gap
# of 12-20 seconds between searches, at most 15 an hour and 100 a day; a
# search that is not its turn goes to the next source (Naver, DuckDuckGo)
# instead of waiting. If a CAPTCHA appears anyway it is never answered: Google
# is left alone for 30 minutes, then 2, 8, 24 hours. Pages that refuse a plain
# request or are drawn by script are also read in this Chrome.
# Google's terms do not allow automated searching; this is off by default.
# WEB_SEARCH_BROWSER=chrome
# WEB_SEARCH_BROWSER_GAP=12          seconds between searches, at least
# WEB_SEARCH_BROWSER_JITTER=8        plus up to this many, at random
# WEB_SEARCH_BROWSER_PER_HOUR=15
# WEB_SEARCH_BROWSER_PER_DAY=100
# WEB_SEARCH_BROWSER_MAX_WAIT=6      seconds a search may wait for its turn
# WEB_SEARCH_BROWSER_IDLE=300        seconds before an idle Chrome is closed
# CHROME_PATH=                       if Chrome (or Edge) is not found


# ---------------------------------------------------------------------------
# The engines this app runs  (see engines/README.md)
# ---------------------------------------------------------------------------
# Every one of these is optional. With nothing set, each engine is looked for in
# `engines/<name>` and started with the interpreter bundled inside it, which is
# how this app expects to find them. Set one only to point at an install kept
# somewhere else on purpose.

# Where GPT-SoVITS lives. Default: engines/gpt-sovits
GPT_SOVITS_PATH=

# The interpreter to run it with. Default: <root>\runtime\python.exe, the one
# the Windows integration package ships; otherwise a 3.10 install works.
GPT_SOVITS_PYTHON=

# Where ACE-Step 1.5 lives, and what to run it with.
# Defaults: engines/ace-step, and its own .venv\Scripts\python.exe
ACE_STEP_PATH=
ACE_STEP_PYTHON=
# Where its API listens. Default 127.0.0.1:8001
ACE_STEP_HOST=
ACE_STEP_PORT=

# Folder containing ffmpeg.exe. GPT-SoVITS shells out to it for any reference
# clip that is not already 32 kHz wav. Leave blank if ffmpeg is on PATH.
FFMPEG_BIN=

# Inference config, relative to GPT_SOVITS_PATH.
GPT_SOVITS_CONFIG=GPT_SoVITS/configs/tts_infer.yaml

# Where the inference server listens. Changing these needs a dev-server restart,
# because the /tts-api proxy target is resolved at startup.
TTS_HOST=127.0.0.1
TTS_PORT=9880

# ---------------------------------------------------------------- speech in
#
# Where a local speech-to-text server is listening. Anything that speaks the
# OpenAI /v1/audio/transcriptions shape works: faster-whisper-server,
# whisper.cpp's server, speaches.
#
# Why bother, when the browser already has SpeechRecognition: on Chrome that
# one uploads your audio to Google. It needs the internet, it sends what you
# said to somebody else, and it is markedly worse in Korean than Whisper is.
# In an app whose whole point is that the model runs on your machine, the
# microphone was the last thing still leaving the building.
#
# Leave it as it is if you have no such server; the browser's recogniser stays
# the fallback and nothing changes.
STT_HOST=127.0.0.1
STT_PORT=8000


# ---------------------------------------------------------------------------
# Serving the built app to other machines  (see server/README.md)
# ---------------------------------------------------------------------------
# 127.0.0.1 keeps the server on this machine; 0.0.0.0 makes it reachable.
HOST=127.0.0.1
# Keep this at 5173. Browser storage is scoped per origin and the port is part
# of it, so serving on another port hides every chat and setting saved before —
# they are not deleted, just unreachable until you serve on 5173 again.
PORT=5173

# The one address every device should open, and the same reasoning as the port
# above taken to its conclusion: the *host* is part of an origin too. This
# server answers on several — localhost, its LAN address, a nip.io hostname, a
# public one — and a browser treats each as a separate website, with its own
# chats, its own settings and its own login cookie. Nothing is lost when that
# happens; it is just filed under an address you are not looking at, and the
# account sync is left to reconcile two caches that never needed to differ.
#
# Set this and the launcher opens it, the startup banner leads with it, and the
# app says so when it is loaded from anywhere else. Every other address still
# works — a server that refuses the address you can actually reach is worse
# than one that costs you a second login.
#
# Pick the address that works from EVERY device you use. A LAN address is fine
# on your own wifi; if you reach this from mobile data, use the public one.
# Whatever you choose, register it with Google and Kakao as well.
#
#   PUBLIC_ORIGIN=http://192.168.1.20.nip.io:5173
#   PUBLIC_ORIGIN=http://203.0.113.9.nip.io:5173
PUBLIC_ORIGIN=

# Required as soon as HOST is not loopback — the server refuses to start
# otherwise, because its Ollama proxy would be open to anything that can reach
# it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ACCESS_TOKEN=

# The /localfs routes read and write anywhere this process can reach. That is
# the point on localhost and a remote file-access hole on a public server.
ALLOW_LOCAL_FS=false

OLLAMA_URL=http://127.0.0.1:11434
# Optional private Ollama runtime (set OLLAMA_URL to http://127.0.0.1:11435).
# Starts automatically in production/dev; never terminates the desktop app.
# Uses q8_0 KV cache, flash attention, one resident model and multi-GPU scheduling.
OLLAMA_MANAGED=false
# Free VRAM target in MiB; 2048,768 was benchmarked on RTX 5070 Ti + GTX 1660 SUPER.
# Tune for your hardware. Models and context lengths are not changed.
OLLAMA_MANAGED_FIT_TARGET=2048,768

# ---------------------------------------------------------------- the engine
#
# Which server actually runs the model: `ollama` (the default, and what this
# app was built against) or `llamacpp`.
#
# Be clear about what the switch buys, because the headline number is
# misleading. Ollama *is* llama.cpp underneath, and measured head to head the
# gap is around ten percent — real, but not why you would do this.
#
# The reason is the flags. If a model does not fit in VRAM, `--flash-attn` and
# a quantised KV cache decide how many layers land on the GPU at all, and the
# difference between 34% offloaded and 100% offloaded is two to three times the
# speed, not ten percent. Ollama does not expose them; llama-server takes them
# on the command line.
#
# Nothing in the browser changes. server/llamacpp.js translates, so vision
# detection, tool detection, the model list, downloads, the tokens/s footer and
# the context gauge all keep working — see the mapping table at the top of that
# file.
#
# llama-server must be started in ROUTER mode, or there is no model list and no
# switching:
#
#   llama-server --models-dir D:\models --port 8080 \
#     --flash-attn --cache-type-k q8_0 --cache-type-v q8_0 \
#     -ngl 999 -c 8192
#
#   --flash-attn                  cheaper attention; almost always a win
#   --cache-type-k/v q8_0         halves the KV cache, which is what frees the
#                                 VRAM that buys you the extra layers
#   -ngl 999                      put every layer it can on the GPU
#   -c 8192                       the context. Note this is fixed at load time
#                                 in llama.cpp, so the app reports the real
#                                 figure rather than the one you type into
#                                 Settings; num_ctx has no per-request meaning
#                                 on this backend.
#
LLM_BACKEND=ollama
LLAMACPP_URL=http://127.0.0.1:8080


# ------------------------------------------------ Claude, GPT and Gemini (CLI)
#
# The coding CLIs already signed in on this machine, offered as models beside
# the local ones -- no API key. Each answer runs the CLI once, headless, and
# spends the same subscription quota the terminal does:
#
#   claude-code:<model>   Claude Code  (claude -p)        text and images
#   codex:<model>         Codex        (codex app-server) text and images
#   agy:<model>           Antigravity  (agy --print)      text, and images it opens itself; Gemini,
#                                                         and whatever else
#                                                         `agy models` lists
#
# The Gemini CLI is not one of them: Google has retired its free individual
# tier in favour of Antigravity, which serves the same models.
#
# Any CLI found on PATH (or in its usual install folder) is offered. Claude
# Code runs with no tools; Codex runs sandboxed read-only. Anyone who can use
# this app can use these models, on your subscription.
#
# With the tools toggle on, Claude Code and Codex are also handed the MCP
# servers from mcp.json for that turn (the same allow/deny lists apply) and
# run them in their own agent loop; Claude Code also gets web search and page
# fetch. No shell, no file edits. Antigravity gets the same servers in its chat
# agent's own file (mcpServers in ~/.gemini/config/agents/ollama-webui-chat-mcp).
# Settings > Tools shows what each CLI would get.
#
# CLI_AGY_MCP=off           make agy use the app's tool tags like a local model
#                           instead (on by default)
#
# CLI_MCP=false             never hand the CLIs the MCP servers
# CLI_WEB=false             never give Claude Code web search / fetch
# CLI_EFFORT=medium         reasoning effort when the chat leaves it on "auto"
#                           (Claude: low..max; Codex: minimal..xhigh)
#
# Thinking: unless the chat's thinking is "off", Claude Code is asked for its
# reasoning summarized (--thinking-display) and Codex for a reasoning summary
# (model_reasoning_summary). Headless, both hide it by default.
# agy runs as a small chat agent of its own (~/.gemini/config/agents/
# ollama-webui-chat, hidden, written by the server) instead of as a coding
# agent: no default agent prompt, no tool definitions, none of your agy rules
# -- about 8,000 input tokens for "hello" become about 1,000.
# CLI_AGY_AGENT=off             run agy as itself, as before
#
# CLI_THINKING_DISPLAY=off      for a Claude Code too old to know the flag
# CLI_REASONING_SUMMARY=concise auto | concise | detailed (default) | none
#
# Usage left and reset times appear in the header next to the model picker for
# a CLI model, and in Settings > Tools. They are what the CLI itself last said
# (Claude Code with each answer; Codex with each answer and in its session
# logs), saved to server/data/cli-limits.json -- nothing is asked of the
# providers directly.
#
# CLI_MODELS=false          offer none of them
# CLI_PROVIDERS=claude-code,agy   only these
# CLI_CLAUDE_MODELS=opus,sonnet,haiku   the lists; unset, Codex's and agy's
# CLI_CODEX_MODELS=gpt-5.5              come from the CLIs themselves
# CLI_AGY_MODELS=gemini-3.1-pro-high
# CLAUDE_CLI_PATH= CODEX_CLI_PATH= AGY_CLI_PATH=   where each one is, if not found
# CLI_TIMEOUT_MS=1800000    how long one answer may take (default 30 min)
#
# When a CLI is over its usage limit, another model can answer instead. The
# models are tried in order; a CLI known to be over its limit is not started,
# one that refuses is passed over if it had said nothing yet, and anything
# that is not a CLI name is a local model. The answer says who wrote it.
# Comparisons and evaluations never fall back. Whoever hit the limit is sent a
# notification when it resets (with "notify when done" switched on).
# CLI_FALLBACK=codex:gpt-5.5,agy:gemini-3.1-pro-high,qwen3:32b
#
# A CLI conversation is resumed (Claude Code --resume, Codex thread/resume, agy
# --conversation) instead of being sent whole every turn, whenever the history
# up to the last answer is exactly the one that answer was given to; an edit or
# a regeneration sends it whole, as before. Most of the prompt then comes from
# the provider's cache. Sessions are kept in the CLI's own store, in a scratch
# project (Codex's also appear in `codex resume`).
# CLI_RESUME=false              send every turn whole
# CLI_RESUME=claude-code,codex  only these
# CLI_RESUME_TTL_HOURS=72       forget a session after this long
#
# Every CLI answer is kept in server/data/cli-usage.jsonl (tokens, cache, and
# the API price Claude Code reports) and summed in Settings > Tools.
#
# Coding agent mode (server/cliProject.js). A chat with a working folder set in
# the composer menu runs the CLI *in that folder* as the coding agent it is --
# its own system prompt, the folder's CLAUDE.md / AGENTS.md / GEMINI.md. "Plan
# only" reads and proposes; "Edit" lets it edit files there (Claude Code
# acceptEdits, Codex workspace-write) and asks in the browser before anything
# else (commands, writes outside). Unanswered for 10 minutes = declined. Every
# run's changes are shown as diffs and can be undone in Settings > Tools (git
# snapshots through a throwaway index; your index, branch and stash are not
# touched). Off unless this is set -- only folders under these can be named:
# CLI_PROJECT_ROOTS=C:\code;D:\work
# CLI_MAX_TURNS=40              stop a Claude Code run after this many turns
# CLI_DAILY_BUDGET_USD=20       past this (API-equivalent) today, CLI models are
#                               skipped for the next in CLI_FALLBACK, or refused
# CLI_AGY_PROJECT_EDIT=on       agy cannot ask first, so it only plans unless on
# CLI_AGY_5H_RUNS=50            what agy's 5-hour window holds, for its estimate
#                               (otherwise learned from when it last said "limit")
# CLI_EXTENSIONS_EDIT=on        switch skills/subagents/prompts on and off from
#                               the browser (renames SKILL.md -> SKILL.md.disabled)
# CLI_TERMINAL_IMPORT=on        list ~/.claude/projects and ~/.codex/sessions so
#                               a terminal conversation can be continued here
# Scheduled turns with a CLI model now run the CLI (in the chat's folder, if set).
#
# A local model can hand one hard question to a CLI model with the delegate
# MCP server, server/mcpDelegate.mjs -- see "Asking a bigger model" in README.


# ------------------------------------------------------------- pictures, film
#
# Image and video generation runs in ComfyUI, as its own process — the same
# arrangement as the TTS and STT servers above, and for the same reason: these
# are multi-gigabyte PyTorch models and no amount of Node will host them.
#
#   git clone https://github.com/comfyanonymous/ComfyUI
#   cd ComfyUI && pip install -r requirements.txt
#   python main.py --listen 127.0.0.1 --port 8188
#
# Generation runs the ComfyUI workflows in workflows/ — the files exported from
# ComfyUI itself, converted to the API format at request time. Edit one in
# ComfyUI, save over the file, and the next generation uses it; there is nothing
# to restart. server/workflows.js says where each one's prompt, size, sampler,
# VAE and LoRA live, and the Studio renders only the controls that workflow
# actually has.
#
#   Krea 2 Turbo    8 steps, guidance 1, with a built-in prompt refiner.
#   Anima Base      anime and illustration; booru tags or a sentence.
#                   Non-commercial licence — fine for personal use, not for a
#                   product.
#   MiniMax H3      video with sound, and a reference-image input, which is what
#                   makes "turn this picture into a video" work.
#                   NOTE: the H3 Community Licence excludes the EU, the UK,
#                   South Korea and the US from *local* deployment. The hosted
#                   API is available worldwide and is the licensed route in
#                   those places. This install is configured to run it locally
#                   by explicit choice of its owner.
#
COMFYUI_URL=http://127.0.0.1:8188

# The half-drawn picture the Studio shows while a generation runs.
#
# ComfyUI's own default is `none`, which is why it broadcasts step counts and no
# picture; this is asked for per prompt, so nothing has to be restarted.
#
#   auto        latent2rgb — a matrix multiply on the latent, with nothing to
#               download. It made no difference to the generation times
#               measured here. The sensible default.
#   taesd       prettier, and needs a decoder in models/vae_approx.
#   none        off, for a machine with no VRAM to spare.
#   default     whatever ComfyUI was started with. Use this if you passed
#               --preview-method on its command line and meant it.
#
# ComfyUI applies this process-wide rather than per request, so it also becomes
# what ComfyUI's own tab shows until something changes it back.
COMFYUI_PREVIEW=auto

# One model on the graphics card at a time.
#
# The chat model and the picture model are separate processes that do not know
# about each other. Left alone, a picture asked for in a conversation is drawn
# with the chat model still resident, both spill into system RAM, and the whole
# machine stutters. So the server takes turns: every language model is unloaded
# before a ComfyUI job is queued, and ComfyUI is told to let go of its models
# before the next language-model request (only when nothing is being drawn).
# Chat requests arriving while a ComfyUI job is drawing are refused with 503.
# This avoids loading a second large model into system RAM.
#
# Each switch costs a reload of a few seconds. Set false if your card holds
# both comfortably and you would rather keep them loaded.
VRAM_EXCLUSIVE=true
#
# The model files each workflow names are the workflow's own business — pick a
# different checkpoint, VAE or LoRA in the Studio and it overrides them for that
# generation without touching the file.



# HTTPS. Without these the server runs plain HTTP and says so.
TLS_KEY_FILE=
TLS_CERT_FILE=

# Free subdomain that follows your changing home IP (duckdns.org).
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=

# A phone on your own wifi skips the token; anything from outside still needs
# it. Set false on a network you do not control, where "same network" means
# nothing about who is on it.
TRUST_LAN=true

# Online SQLite backups. The server stays running while VACUUM INTO creates a
# consistent snapshot, then verifies integrity and foreign keys before keeping
# the file. Backups default to server/data/backups.
DB_BACKUP_ENABLED=true
DB_BACKUP_INTERVAL_MS=21600000
DB_BACKUP_RETENTION=14
# DB_BACKUP_DIR=D:\Backups\ollama-webui

# Memory safety defaults (enforced in code):
# - Replay cache: 4 MiB/job, 32 MiB total, 128 jobs, expires after 30 minutes.
# - Inference: at most two requests through the proxy; body <= 32 MiB.
# - New inference/Studio jobs require max(4 GiB, 10% of RAM) free.
# - Ollama requests stop after 120 seconds without data or 30 minutes total.
# - Active Ollama requests stop below max(1 GiB, 3% of RAM) free.
# These checks cannot constrain jobs launched directly in Ollama or ComfyUI.
