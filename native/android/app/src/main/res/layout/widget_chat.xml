<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget (ChatWidget.java): a search-bar-like row, then three buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:padding="8dp" android:background="@drawable/widget_bg">
    <TextView android:id="@+id/widget_ask"
        android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
        android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="8dp"
        android:background="@drawable/widget_field" android:drawableStart="@drawable/ic_shortcut_chat"
        android:drawablePadding="10dp" android:textColor="#B9B3A7" android:textSize="14sp"
        android:singleLine="true" android:ellipsize="end" android:text="Ask anything"/>
    <ImageView android:id="@+id/widget_voice" android:layout_width="44dp" android:layout_height="44dp"
        android:layout_marginStart="6dp" android:padding="11dp" android:background="@drawable/widget_button"
        android:src="@drawable/ic_widget_mic" android:contentDescription="Voice"/>
    <ImageView android:id="@+id/widget_new" android:layout_width="44dp" android:layout_height="44dp"
        android:layout_marginStart="6dp" android:padding="11dp" android:background="@drawable/widget_button"
        android:src="@drawable/ic_widget_plus" android:contentDescription="New chat"/>
    <ImageView android:id="@+id/widget_open" android:layout_width="44dp" android:layout_height="44dp"
        android:layout_marginStart="6dp" android:padding="11dp" android:background="@drawable/widget_button"
        android:src="@drawable/ic_widget_history" android:contentDescription="Open"/>
</LinearLayout>
